# Copy to .env for local development. Never commit real secrets.
APP_ENV=development
APP_NAME=SmartDrive API
APP_VERSION=1.0.0

MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=smartdrive

# For production, use a unique random value with at least 32 characters.
JWT_SECRET=change-this-local-development-secret
JWT_ALGORITHM=HS256

# Pydantic Settings expects a JSON array for list-valued environment settings.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

AI_RESEARCH_PROVIDER=gemini
AI_SEARCH_PROVIDER=tavily
OPENAI_API_KEY=
OPENAI_RESEARCH_MODEL=
GEMINI_API_KEY=
GEMINI_RESEARCH_MODEL=
TAVILY_API_KEY=
TAVILY_SEARCH_DEPTH=advanced
TAVILY_MAX_RESULTS=5
