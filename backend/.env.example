# Copy to backend/.env.local for local development (preferred) or backend/.env.
# Local precedence: process environment > .env.local > .env > defaults.
# Set APP_ENV=production in the deployment process environment; production mode
# ignores both dotenv files. Never put production credentials in these files.
APP_ENV=development
APP_NAME=SmartDrive API
APP_VERSION=1.0.0

MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=smartdrive

# Local-only placeholder. For production, inject a unique secret of at least
# 32 characters through the hosting provider's secret environment settings.
JWT_SECRET=change-this-local-development-secret
JWT_ALGORITHM=HS256

# Pydantic Settings expects a JSON array for list-valued environment settings.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

AI_RESEARCH_PROVIDER=gemini
AI_SEARCH_PROVIDER=tavily
# Leave provider values blank for no-cost local testing. Add credentials only
# when you intentionally perform a live provider verification.
GEMINI_API_KEY=
GEMINI_RESEARCH_MODEL=your-enabled-gemini-model
TAVILY_API_KEY=
TAVILY_SEARCH_DEPTH=advanced
TAVILY_MAX_RESULTS=5
